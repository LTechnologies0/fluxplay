/target
**/*.rs.bk
.DS_Store
*.swp
*.log

# Local FFmpeg headers (downloaded for builds without ffmpeg-devel)
crates/fluxplay-player/vendor/ffmpeg-include/

# Secrets & local config (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Local FluxPlay state may contain portal credentials
**/state.json
fluxplay-state.json
