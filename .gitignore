/target
**/*.rs.bk
.DS_Store
*.swp
*.log

# Local FFmpeg headers (downloaded for builds without ffmpeg-devel)
crates/fluxplay-player/vendor/ffmpeg-include/

# Secrets & local config (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
credentials.json
secrets/
crates/fluxplay-android/debug.keystore


# Local FluxPlay state may contain portal credentials
**/state.json
fluxplay-state.json

# proptest failure corpora (reproducers committed only when intentional)
**/proptest-regressions/

# Fuzz: keep harness + curated seeds/dicts; ignore generated corpus/artifacts
fuzz/corpus/
fuzz/artifacts/
fuzz/target/
fuzz/Cargo.lock
!fuzz/seeds/
!fuzz/dictionaries/

# Local screenshots
tmp_fp_*.png
